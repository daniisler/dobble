# Copy this file to ".env" and adjust. ".env" is ignored by git and by the Docker image.

# Name shown in the page title, headings, the 404 page and the admin page.
APP_NAME=MatchMe

# Port the server listens on (the Docker image uses 8054).
PORT=8054

# Admin overview at /admin (HTTP Basic auth). Leave either one empty to disable the page.
# Pick a long random password and serve the site over HTTPS (the reverse proxy does that).
ADMIN_USER=admin
ADMIN_PASSWORD=

# How many seconds the connection to the server may be silent before the browser shows "Connection lost".
# Allowed range 2-120, default 5. Raise it for players on unreliable mobile networks.
CONNECTION_TIMEOUT_SECONDS=5
# How long a player who lost the connection keeps their seat in the room (seconds, 5-600)
RECONNECT_GRACE_SECONDS=60

# Set to 1 when the app runs behind a reverse proxy (nginx): the rate limiter then uses the client address from
# X-Forwarded-For instead of the proxy's own address. Leave unset when the app is exposed directly.
TRUST_PROXY=1

# Where the database and uploaded images are stored (default: ./data, in Docker: the /data volume).
# DATA_DIR=./data
